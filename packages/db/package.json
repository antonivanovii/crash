{
  "name": "@kobold/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch --preserveWatchOutput",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "migrate": "tsx --env-file-if-exists=../../.env src/migrate.ts latest",
    "migrate:down": "tsx --env-file-if-exists=../../.env src/migrate.ts down",
    "migrate:status": "tsx --env-file-if-exists=../../.env src/migrate.ts status",
    "reset": "tsx --env-file-if-exists=../../.env src/migrate.ts reset"
  },
  "dependencies": {
    "@kobold/money": "workspace:*",
    "kysely": "0.29.5",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vitest": "5.0.0"
  }
}
