{
  "name": "@kobold/game-engine",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch --preserveWatchOutput",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:slow": "SLOW_TESTS=1 vitest run"
  },
  "dependencies": {
    "@kobold/money": "workspace:*",
    "@noble/hashes": "2.4.0"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "vitest": "5.0.0"
  }
}
