# ── Общее ────────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=debug

# ── Postgres ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://kobold:kobold@localhost:5432/kobold
DATABASE_POOL_MAX=20

# ── Redis ────────────────────────────────────────────────────────────────────
# Три роли — три логические БД: pub/sub, leader election, cache/rate-limit.
REDIS_URL=redis://localhost:6379
REDIS_DB_PUBSUB=0
REDIS_DB_LOCKS=1
REDIS_DB_CACHE=2

# ── apps/api ─────────────────────────────────────────────────────────────────
API_PORT=3000
API_HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173
SESSION_SECRET=dev-only-change-me-32-chars-minimum-xxxxx

# ── apps/admin-api ───────────────────────────────────────────────────────────
ADMIN_API_PORT=3002

# ── apps/orchestrator ────────────────────────────────────────────────────────
ORCHESTRATOR_PORT=3001
# TTL блокировки лидера и период продления, мс
LEADER_LOCK_TTL_MS=10000
LEADER_RENEW_INTERVAL_MS=3000

# ── apps/settler ─────────────────────────────────────────────────────────────
SETTLER_CONCURRENCY=4

# ── apps/web ─────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:3000
VITE_WS_URL=ws://localhost:3000
